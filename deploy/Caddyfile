{
	email latamcriptomom@gmail.com
}

bitacorabtc.org {
	encode gzip zstd
	header {
		# defer: si no, Caddy escribe el CSP antes del proxy y pisa el nonce de la app.
		defer
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		# El CSP del HTML lo pone la app, con nonce. No declararlo acá: Caddy lo pisa.
	}
	# Solo el proxy. /logos/ es un archivo propio y no entra en esta regla.
	@logo path /logo /logo/
	header @logo {
		defer
		Content-Security-Policy "default-src 'none'; sandbox"
		X-Content-Type-Options nosniff
	}
	@noindex path /LICENSE /humans.txt /labif /COPYRIGHT
	header @noindex X-Robots-Tag "noindex, follow"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /data/* Cache-Control "public, max-age=86400"
	header /latam-cripto-mom.jpg Cache-Control "public, max-age=604800"
	header /contribuir-qr.png Cache-Control "public, max-age=604800"
	header /contribuir-ln.png Cache-Control "public, max-age=604800"
	header /og.jpg Cache-Control "public, max-age=86400"
	# Extractores (no AEO). GPTBot / Claude / Perplexity / Google siguen.
	@extractors header_regexp User-Agent (?i)(CCBot|Bytespider|Diffbot|ImagesiftBot|magpie-crawler|YouBot|DataForSeoBot|PetalBot|Scrapy|python-requests)
	handle @extractors {
		abort
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
	log {
		output stdout
	}
}

www.bitacorabtc.org {
	redir https://bitacorabtc.org{uri} permanent
}

