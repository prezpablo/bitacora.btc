		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://tiles.openfreemap.org; img-src 'self' data: blob: https://static.btcmap.org https://*.btcmap.org https://tiles.openfreemap.org https://*.tile.opentopomap.org https://*.tile.openstreetmap.fr https://images.lumacdn.com https://*.lumacdn.com https://*.meetupstatic.com https://img.evbuc.com https://cdn.evbuc.com https://images.unsplash.com; connect-src 'self' https://get.geojs.io https://ipwho.is https://nominatim.openstreetmap.org https://tiles.openfreemap.org https://*.tile.opentopomap.org https://static.btcmap.org https://api.btcmap.org; worker-src 'self' blob: 'wasm-unsafe-eval'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co"
	}
	@plain path /LICENSE /humans.txt
	header @plain X-Robots-Tag "noindex, follow"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /data/* Cache-Control "public, max-age=86400"
	header /latam-cripto-mom.jpg Cache-Control "public, max-age=604800"
	header /contribuir-qr.png Cache-Control "public, max-age=604800"
	header /contribuir-ln.png Cache-Control "public, max-age=604800"
	header /og.jpg Cache-Control "public, max-age=86400"
	# Extractores (no AEO). GPTBot / Claude / Perplexity / Google siguen.
	@extractors header_regexp User-Agent (?i)(CCBot|Bytespider|Diffbot|ImagesiftBot|magpie-crawler|YouBot|DataForSeoBot|PetalBot|Scrapy|python-requests)
	handle @extractors {
		abort
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
