rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /places/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /communities/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
